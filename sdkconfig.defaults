CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_SEND_SERVICE_CHANGE_MANUAL=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=y
CONFIG_BLE_MESH_GATT_PROXY_SERVER=y
CONFIG_BLE_MESH_RELAY=y
CONFIG_BLE_MESH_SETTINGS=y
CONFIG_BLE_MESH_SUPPORT_BLE_ADV=y
CONFIG_BLE_MESH_V11_SUPPORT=n
CONFIG_BLE_MESH_STORE_TIMEOUT=0
CONFIG_BLE_MESH_SEQ_STORE_RATE=128
CONFIG_BLE_MESH_CRPL=128
CONFIG_BLE_MESH_ADV_BUF_COUNT=40
CONFIG_BLE_MESH_RX_SEG_MSG_COUNT=16
CONFIG_BLE_MESH_TX_SEG_MSG_COUNT=8
CONFIG_BLE_MESH_RX_SDU_MAX=96
CONFIG_BLE_MESH_TX_SEG_MAX=8
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
# Mesh delayed work and Bluedroid GATT/SMP share the OSI alarm pool.
# 50 slots are exhausted on phone connect with RX=16 / TX=8; reserve headroom.
CONFIG_BT_ALARM_MAX_NUM=128
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_COMPILER_CXX_EXCEPTIONS=n
