CONFIG_BLE_MESH_PROVISIONER=y
CONFIG_BLE_MESH_CFG_CLI=y
CONFIG_BLE_MESH_MAX_PROV_NODES=32
CONFIG_BLE_MESH_PBA_SAME_TIME=1
CONFIG_BLE_MESH_PROVISIONER_SUBNET_COUNT=2
CONFIG_BLE_MESH_PROVISIONER_APP_KEY_COUNT=2
# GATT/Mesh application callbacks log through the buffered UART driver. The
# default 3072-byte BTC stack overflowed during GATT registration on the bench.
CONFIG_BT_BTC_TASK_STACK_SIZE=6144
